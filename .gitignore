# macOS and Python-generated files
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]

# Local environments and credentials
.venv/
venv/
.env
.env.*
kaggle.json
access_token
*.pem
*.key

# Large downloaded/generated replay corpora
experiments/*_replays/
experiments/*_corpus/
experiments/kaggle_episodes/
experiments/super_replay_unseen/
experiments/leaderboard_replays/
experiments/top_player_replays/

# Generated analysis caches and large route artifacts
experiments/*cache*
experiments/*.partial
experiments/*route_bank.json
experiments/*route_executor.json

# Generated experiment JSON can be reproduced by the checked-in scripts.
# Keep lightweight manifests that describe the source datasets.
experiments/*.json
!experiments/*manifest*.json

# The current-state registry is not a generated result: it is the pointer that
# says which agent is the verified leaderboard best, which is the live research
# candidate, and what was last packaged. It must travel with the repository.
!experiments/current_best.json

# Sealed-holdout provenance, three named files only. These are not reproducible
# results: the first declares which Majkel episodes were sealed away before any
# of them was downloaded, and the other two are the G0 artifacts that
# declaration binds by SHA-256. A holdout that cannot be proven sealed is worth
# nothing, and re-downloading the replays cannot restore the proof, so this
# chain has to travel with the repository.
!experiments/majkel_g1_split_lock.json
!experiments/majkel_g0_candidate_lock.json
!experiments/majkel_g0_holdout_evaluation.json
